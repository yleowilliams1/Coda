+	return ok;
+}
+
+bool read_entity_save(struct EntityList *out, const char *map_path, u32 number){
+	if(!out || !map_path){GILD_LOG(GILD_IS_NULL, "Passed NULL entity list or map path"); return false;}
+	char *path = map_entity_save_path(map_path, number);
+	if(!path){return false;}
+	struct EntityList tmp = {0};
+	bool ok = read_map_entities(&tmp, path);
+	if(ok && tmp.save_index != number){
+		GILD_LOG(GILD_CORRUPT, "%s holds save %u, not %u", path, tmp.save_index, number);
+		free_entity_list(&tmp);
+		ok = false;
+	}
+	free(path);
+	if(!ok){return false;}
+	*out = tmp;
+	return true;
+}
+
+void free_entity_list(struct EntityList *l){
+	if(!l){return;}
+	free_entity_array(l->items, l->count);
+	l->items = NULL;
+	l->count = 0;
+	l->save_index = 0;
 }
 
